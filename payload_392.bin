":false,"EndLine":855,"ReplacementContent":"    const setsPending = (data.sets || []).filter(t =\u003e !t.completed);\n    const trainsPending = (data.trains || []).filter(t =\u003e !t.completed);\n    const annualTrainsPending = (data.annualTrains || []).filter(t =\u003e !t.completed);\n    const projectsPending = (data.projects || []).filter(t =\u003e !t.completed);\n\n    const totalUncompleted = hunosPending.length + yunqueLargasPending.length + yunqueRapidasPending.length + roblePending.length + leonesPending.length + setsPending.length + trainsPending.length + annualTrainsPending.length + projectsPending.length;\n\n    if (totalUncompleted === 0) {\n      setSebastianResponse(\"Vuestros backlogs est√°n completamente vac√≠os, mi se√±or. Disfrutad de un merecido descanso.\\nSebastian, su mayordomo\");\n      setPriorityTaskId(\"none\");\n      setGeminiLoading(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() =\u003e {\n      controller.abort();\n    }, 10000);\n\n    try {\n      const apiKey = process.env.GEMINI_API_KEY || ((import.meta as any).env \u0026\u0026 ((import.meta as any).env.VITE_GEMINI_API_KEY || (import.meta as any).env.GEMINI_API_KEY));\n\n      console.log(\"Modo Tel√≥n - API Key starts with:\", apiKey ? apiKey.substring(0, 7) + \"...\" : \"undefined\");\n\n      if (!apiKey) {\n        throw new Error(\"GEMINI_API_KEY is not defined in environment variables.\");\n      }\n\n      const promptText = `\nEres Sebastian, el mayordomo del Reino. Tu se√±or te ha indicado que hoy tiene un nivel de energ√≠a de ${energyVal} sobre 10.\nAnaliza la lista de tareas pendientes que tiene acumuladas en sus diferentes backlogs y selecciona una √∫nica tarea prioritaria que se adapze mejor a su nivel de energ√≠a de hoy.\nNivel de energ√≠a: ${energyVal}/10 (donde 1 es muy baja energ√≠a y 10 es energ√≠a m√°xima).\n\n${data.sebastianInstructions ? `Directrices y preferencias de tu se√±or para hoy:\n${data.sebastianInstructions}\n\n` : ''}Backlogs de tareas pendientes:\n1. Hunos (Tareas Diarias):\n${hunosPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n2. Yunque Largas (Tareas Complejas):\n${yunqueLargasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n3. Yunque R√°pidas (Tareas R√°pidas):\n${yunqueRapidasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n4. Roble (Tareas Trimestrales/Proyectos):\n${roblePending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n5. Leones (Objetivos de Recursos):\n${leonesPending.map(t =\u003e `- [${t.id}] ${t.name} (${t.current}/${t.target} ${t.unit})`).join('\\n')}\n\n6. Setas (Tareas Semanales):\n${setsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n7. Trenes (Tareas Mensuales):\n${trainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n8. Trenes Anuales (Tareas Anuales):\n${annualTrainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n9. Nubes (Proyectos Independientes):\n${projectsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\nInformaci√≥n de Contexto Adicional:\n- Bosque (Entrenamiento de Fuerza):\n  * Series acumuladas en la sesi√≥n actual: ${data.exercise.seriesCurrent || 0}/9 (faltan ${9 - (data.exercise.seriesCurrent || 0)} para completar un entrenamiento completo).\n  * Sesiones completadas este mes: ${data.exercise.daysTrained || 0}.\n  ${data.exercise.notes ? `* Instrucciones espec√≠ficas para el Bosque: \"${data.exercise.notes}\"` : ''}\n\n- Brotes (Amigos/Relaciones):\n${(data.friends || []).map(f =\u003e {\n  const days = getDaysSinceLastInteractionText(f.lastInteraction);\n  return `  * ${f.name} (√öltimo contacto: hace ${days})`;\n}).join('\\n')}","StartLine":796,"TargetContent":"    const setsPending = (data.sets || []).filter(t =\u003e !t.completed);\n    const trainsPending = (data.trains || []).filter(t =\u003e !t.completed);\n    const annualTrainsPending = (data.annualTrains || []).filter(t =\u003e !t.completed);\n\n    const totalUncompleted = hunosPending.length + yunqueLargasPending.length + yunqueRapidasPending.length + roblePending.length + leonesPending.length + setsPending.length + trainsPending.length + annualTrainsPending.length;\n\n    if (totalUncompleted === 0) {\n      setSebastianResponse(\"Vuestros backlogs est√°n completamente vac√≠os, mi se√±or. Disfrutad de un merecido descanso.\\nSebastian, su mayordomo\");\n      setPriorityTaskId(\"none\");\n      setGeminiLoading(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() =\u003e {\n      controller.abort();\n    }, 10000);\n\n    try {\n      const apiKey = process.env.GEMINI_API_KEY || ((import.meta as any).env \u0026\u0026 ((import.meta as any).env.VITE_GEMINI_API_KEY || (import.meta as any).env.GEMINI_API_KEY));\n\n      console.log(\"Modo Tel√≥n - API Key starts with:\", apiKey ? apiKey.substring(0, 7) + \"...\" : \"undefined\");\n\n      if (!apiKey) {\n        throw new Error(\"GEMINI_API_KEY is not defined in environment variables.\");\n      }\n\n      const promptText = `\nEres Sebastian, el mayordomo del Reino. Tu se√±or te ha indicado que hoy tiene un nivel de energ√≠a de ${energyVal} sobre 10.\nAnaliza la lista de tareas pendientes que tiene acumuladas en sus diferentes backlogs y selecciona una √∫nica tarea prioritaria que se adapte mejor a su nivel de energ√≠a de hoy.\nNivel de energ√≠a: ${energyVal}/10 (donde 1 es muy baja energ√≠a y 10 es energ√≠a m√°xima).\n\n${data.sebastianInstructions ? `Directrices y preferencias de tu se√±or para hoy:\n${data.sebastianInstructions}\n\n` : ''}Backlogs de tareas pendientes:\n1. Hunos (Tareas Diarias):\n${hunosPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n2. Yunque Largas (Tareas Complejas):\n${yunqueLargasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n3. Yunque R√°pidas (Tareas R√°pidas):\n${yunqueRapidasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n4. Roble (Tareas Trimestrales/Proyectos):\n${roblePending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n5. Leones (Objetivos de Recursos):\n${leonesPending.map(t =\u003e `- [${t.id}] ${t.name} (${t.current}/${t.target} ${t.unit})`).join('\\n')}\n\n6. Setas (Tareas Semanales):\n${setsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n7. Trenes (Tareas Mensuales):\n${trainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n8. Trenes Anuales (Tareas Anuales):\n${annualTrainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}"},{"AllowMultiple":false,"EndLine":1022,"ReplacementContent":"    const setsPending = (data.sets || []).filter(t =\u003e !t.completed);\n    const trainsPending = (data.trains || []).filter(t =\u003e !t.completed);\n    const annualTrainsPending = (data.annualTrains || []).filter(t =\u003e !t.completed);\n    const projectsPending = (data.projects || []).filter(t =\u003e !t.completed);\n\n    const totalUncompleted = hunosPending.length + yunqueLargasPending.length + yunqueRapidasPending.length + roblePending.length + leonesPending.length + setsPending.length + trainsPending.length + annualTrainsPending.length + projectsPending.length;\n\n    if (totalUncompleted === 0) {\n      setFocusRecommendation(\"Vuestros backlogs est√°n completamente vac√≠os, mi se√±or. Disfrutad de un merecido descanso.\\nSebastian, su mayordomo\");\n      setFocusRecommendedTaskId(\"none\");\n      setFocusLoading(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() =\u003e {\n      controller.abort();\n    }, 10000);\n\n    try {\n      const apiKey = process.env.GEMINI_API_KEY || ((import.meta as any).env \u0026\u0026 ((import.meta as any).env.VITE_GEMINI_API_KEY || (import.meta as any).env.GEMINI_API_KEY));\n      if (!apiKey) {\n        throw new Error(\"GEMINI_API_KEY is not defined.\");\n      }\n\n      const promptText = `\nEres Sebastian, el mayordomo del Reino. Tu se√±or te ha pedido una recomendaci√≥n r√°pida (\"Enfoque\") para retomar el hilo del d√≠a.\nAnaliza la lista de tareas pendientes en sus backlogs y selecciona una √∫nica tarea prioritaria para retomar el rumbo de forma inmediata.\n\n${data.sebastianInstructions ? `Directrices y preferencias de tu se√±or:\n${data.sebastianInstructions}\n\n` : ''}Backlogs de tareas pendientes:\n1. Hunos (Tareas Diarias):\n${hunosPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n2. Yunque Largas (Tareas Complejas):\n${yunqueLargasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n3. Yunque R√°pidas (Tareas R√°pidas):\n${yunqueRapidasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n4. Roble (Tareas Trimestrales/Proyectos):\n${roblePending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n5. Leones (Objetivos de Recursos):\n${leonesPending.map(t =\u003e `- [${t.id}] ${t.name} (${t.current}/${t.target} ${t.unit})`).join('\\n')}\n\n6. Setas (Tareas Semanales):\n${setsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n7. Trenes (Tareas Mensuales):\n${trainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n8. Trenes Anuales (Tareas Anuales):\n${annualTrainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n9. Nubes (Proyectos Independientes):\n${projectsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\nInformaci√≥n de Contexto Adicional:\n- Bosque (Entrenamiento de Fuerza):\n  * Series acumuladas en la sesi√≥n actual: ${data.exercise.seriesCurrent || 0}/9 (faltan ${9 - (data.exercise.seriesCurrent || 0)} para completar un entrenamiento completo).\n  * Sesiones completadas este mes: ${data.exercise.daysTrained || 0}.\n  ${data.exercise.notes ? `* Instrucciones espec√≠ficas para el Bosque: \"${data.exercise.notes}\"` : ''}\n\n- Brotes (Amigos/Relaciones):\n${(data.friends || []).map(f =\u003e {\n  const days = getDaysSinceLastInteractionText(f.lastInteraction);\n  return `  * ${f.name} (√öltimo contacto: hace ${days})`;\n}).join('\\n')}","StartLine":961,"TargetContent":"    const setsPending = (data.sets || []).filter(t =\u003e !t.completed);\n    const trainsPending = (data.trains || []).filter(t =\u003e !t.completed);\n    const annualTrainsPending = (data.annualTrains || []).filter(t =\u003e !t.completed);\n\n    const totalUncompleted = hunosPending.length + yunqueLargasPending.length + yunqueRapidasPending.length + roblePending.length + leonesPending.length + setsPending.length + trainsPending.length + annualTrainsPending.length;\n\n    if (totalUncompleted === 0) {\n      setFocusRecommendation(\"Vuestros backlogs est√°n completamente vac√≠os, mi se√±or. Disfrutad de un merecido descanso.\\nSebastian, su mayordomo\");\n      setFocusRecommendedTaskId(\"none\");\n      setFocusLoading(false);\n      return;\n    }\n\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() =\u003e {\n      controller.abort();\n    }, 10000);\n\n    try {\n      const apiKey = process.env.GEMINI_API_KEY || ((import.meta as any).env \u0026\u0026 ((import.meta as any).env.VITE_GEMINI_API_KEY || (import.meta as any).env.GEMINI_API_KEY));\n      if (!apiKey) {\n        throw new Error(\"GEMINI_API_KEY is not defined.\");\n      }\n\n      const promptText = `\nEres Sebastian, el mayordomo del Reino. Tu se√±or te ha pedido una recomendaci√≥n r√°pida (\"Enfoque\") para retomar el hilo del d√≠a.\nAnaliza la lista de tareas pendientes en sus backlogs y selecciona una √∫nica tarea prioritaria para retomar el rumbo de forma inmediata.\n\n${data.sebastianInstructions ? `Directrices y preferencias de tu se√±or:\n${data.sebastianInstructions}\n\n` : ''}Backlogs de tareas pendientes:\n1. Hunos (Tareas Diarias):\n${hunosPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n2. Yunque Largas (Tareas Complejas):\n${yunqueLargasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n3. Yunque R√°pidas (Tareas R√°pidas):\n${yunqueRapidasPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n4. Roble (Tareas Trimestrales/Proyectos):\n${roblePending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n5. Leones (Objetivos de Recursos):\n${leonesPending.map(t =\u003e `- [${t.id}] ${t.name} (${t.current}/${t.target} ${t.unit})`).join('\\n')}\n\n6. Setas (Tareas Semanales):\n${setsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n7. Trenes (Tareas Mensuales):\n${trainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}\n\n8. Trenes Anuales (Tareas Anuales):\n${annualTrainsPending.map(t =\u003e `- [${t.id}] ${t.text}${t.notes ? ` (Nota: ${t.notes})` : ''}`).join('\\n')}"},{"AllowMultiple":false,"EndLine":1129,"ReplacementContent":"    } catch (e) {\n      console.error(\"Error in focus recommendation:\", e);\n      applyFocusFallback(hunosPending, yunqueLargasPending, yunqueRapidasPending, roblePending, leonesPending, setsPending, trainsPending, annualTrainsPending, projectsPending);\n    } finally {\n      clearTimeout(timeoutId);\n      setFocusLoading(false);\n    }\n  };\n\n  const applyFocusFallback = (\n    hunosPending: any[],\n    yunqueLargasPending: any[],\n    yunqueRapidasPending: any[],\n    roblePending: any[],\n    leonesPending: any[],\n    setsPending: any[],\n    trainsPending: any[],\n    annualTrainsPending: any[],\n    projectsPending: any[]\n  ) =\u003e {\n    let selected = null;\n    if (hunosPending.length \u003e 0) selected = hunosPending[0];\n    else if (yunqueRapidasPending.length \u003e 0) selected = yunqueRapidasPending[0];\n    else if (yunqueLargasPending.length \u003e 0) selected = yunqueLargasPending[0];\n    else if (roblePending.length \u003e 0) selected = roblePending[0];\n    else if (leonesPending.length \u003e 0) selected = leonesPending[0];\n    else if (setsPending.length \u003e 0) selected = setsPending[0];\n    else if (trainsPending.length \u003e 0) selected = trainsPending[0];\n    else if (annualTrainsPending.length \u003e 0) selected = annualTrainsPending[0];\n    else if (projectsPending.length \u003e 0) selected = projectsPending[0];\n\n    if (selected) {\n      setFocusRecommendation(\"Mi se√±or, no he podido contactar con el or√°culo de Gemini, pero os sugiero esta tarea para hoy.\\nEspero que vuestra jornada sea provechosa. Sebastian, su mayordomo\");\n      setFocusRecommendedTaskId(selected.id);\n    } else {\n      setFocusRecommendation(\"Vuestros backlogs est√°n completamente vac√≠os, mi se√±or. Disfrutad de un merecido descanso.\\nSebastian, su mayordomo\");\n      setFocusRecommendedTaskId(\"none\");\n    }\n  };\n\n  const getFocusRecommendedTask = (): { text: string; completed: boolean; typeName: string } | null =\u003e {\n    if (!focusRecommendedTaskId || focusRecommendedTaskId === 'none') return null;\n    \n    const huno = data.hunos.find(t =\u003e t.id === focusRecommendedTaskId);\n    if (huno) return { text: huno.text, completed: huno.completed, typeName: \"Diaria\" };\n\n    const yl = (data.yunqueLargas || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (yl) return { text: yl.text, completed: yl.completed, typeName: \"Compleja (Yunque)\" };\n\n    const yr = (data.yunqueRapidas || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (yr) return { text: yr.text, completed: yr.completed, typeName: \"R√°pida (Yunque)\" };\n\n    const ft = (data.forjaTasks || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (ft) return { text: ft.text, completed: ft.completed, typeName: \"Roble\" };\n\n    const lion = (data.leones || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (lion) {\n      const leonesHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('le√≥n') || h.text.toLowerCase().includes('leon') || h.text.toLowerCase().includes('leones'));\n      return { text: lion.name, completed: leonesHuno ? leonesHuno.completed : (lion.current \u003e= lion.target), typeName: \"Recurso (Leones)\" };\n    }\n\n    const setTask = (data.sets || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (setTask) {\n      const setaHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('seta'));\n      return { text: setTask.text, completed: setaHuno ? setaHuno.completed : false, typeName: \"Semanal (Setas)\" };\n    }\n\n    const trainTask = (data.trains || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (trainTask) {\n      const trenHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('tren'));\n      return { text: trainTask.text, completed: trenHuno ? trenHuno.completed : false, typeName: \"Mensual (Trenes)\" };\n    }\n\n    const annualTrainTask = (data.annualTrains || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (annualTrainTask) {\n      const trenHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('tren'));\n      return { text: annualTrainTask.text, completed: trenHuno ? trenHuno.completed : false, typeName: \"Anual (Trenes)\" };\n    }\n\n    const projectTask = (data.projects || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (projectTask) {\n      const nubeHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('nube') || h.text.toLowerCase().includes('proyecto'));\n      return { text: projectTask.text, completed: nubeHuno ? nubeHuno.completed : false, typeName: \"Nubes (Proyectos)\" };\n    }\n\n    return null;\n  };","StartLine":1069,"TargetContent":"    } catch (e) {\n      console.error(\"Error in focus recommendation:\", e);\n      applyFocusFallback(hunosPending, yunqueLargasPending, yunqueRapidasPending, roblePending, leonesPending, setsPending, trainsPending, annualTrainsPending);\n    } finally {\n      clearTimeout(timeoutId);\n      setFocusLoading(false);\n    }\n  };\n\n  const applyFocusFallback = (\n    hunosPending: any[],\n    yunqueLargasPending: any[],\n    yunqueRapidasPending: any[],\n    roblePending: any[],\n    leonesPending: any[],\n    setsPending: any[],\n    trainsPending: any[],\n    annualTrainsPending: any[]\n  ) =\u003e {\n    let selected = null;\n    if (hunosPending.length \u003e 0) selected = hunosPending[0];\n    else if (yunqueRapidasPending.length \u003e 0) selected = yunqueRapidasPending[0];\n    else if (yunqueLargasPending.length \u003e 0) selected = yunqueLargasPending[0];\n    else if (roblePending.length \u003e 0) selected = roblePending[0];\n    else if (leonesPending.length \u003e 0) selected = leonesPending[0];\n    else if (setsPending.length \u003e 0) selected = setsPending[0];\n    else if (trainsPending.length \u003e 0) selected = trainsPending[0];\n    else if (annualTrainsPending.length \u003e 0) selected = annualTrainsPending[0];\n\n    if (selected) {\n      setFocusRecommendation(\"Mi se√±or, no he podido contactar con el or√°culo de Gemini, pero os sugiero esta tarea para hoy.\\nEspero que vuestra jornada sea provechosa. Sebastian, su mayordomo\");\n      setFocusRecommendedTaskId(selected.id);\n    } else {\n      setFocusRecommendation(\"Vuestros backlogs est√°n completamente vac√≠os, mi se√±or. Disfrutad de un merecido descanso.\\nSebastian, su mayordomo\");\n      setFocusRecommendedTaskId(\"none\");\n    }\n  };\n\n  const getFocusRecommendedTask = (): { text: string; completed: boolean; typeName: string } | null =\u003e {\n    if (!focusRecommendedTaskId || focusRecommendedTaskId === 'none') return null;\n    \n    const huno = data.hunos.find(t =\u003e t.id === focusRecommendedTaskId);\n    if (huno) return { text: huno.text, completed: huno.completed, typeName: \"Diaria\" };\n\n    const yl = (data.yunqueLargas || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (yl) return { text: yl.text, completed: yl.completed, typeName: \"Compleja (Yunque)\" };\n\n    const yr = (data.yunqueRapidas || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (yr) return { text: yr.text, completed: yr.completed, typeName: \"R√°pida (Yunque)\" };\n\n    const ft = (data.forjaTasks || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (ft) return { text: ft.text, completed: ft.completed, typeName: \"Roble\" };\n\n    const lion = (data.leones || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (lion) {\n      const leonesHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('le√≥n') || h.text.toLowerCase().includes('leon') || h.text.toLowerCase().includes('leones'));\n      return { text: lion.name, completed: leonesHuno ? leonesHuno.completed : (lion.current \u003e= lion.target), typeName: \"Recurso (Leones)\" };\n    }\n\n    const setTask = (data.sets || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (setTask) {\n      const setaHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('seta'));\n      return { text: setTask.text, completed: setaHuno ? setaHuno.completed : false, typeName: \"Semanal (Setas)\" };\n    }\n\n    const trainTask = (data.trains || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (trainTask) {\n      const trenHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('tren'));\n      return { text: trainTask.text, completed: trenHuno ? trenHuno.completed : false, typeName: \"Mensual (Trenes)\" };\n    }\n\n    const annualTrainTask = (data.annualTrains || []).find(t =\u003e t.id === focusRecommendedTaskId);\n    if (annualTrainTask) {\n      const trenHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('tren'));\n      return { text: annualTrainTask.text, completed: trenHuno ? trenHuno.completed : false, typeName: \"Anual (Trenes)\" };\n    }\n\n    return null;\n  };"},{"AllowMultiple":false,"EndLine":1228,"ReplacementContent":"--- TAREAS DE HOY (Hunos, Yunque, Roble, Leones, Setas, Trenes, Trenes Anuales, Nubes) ---\n${data.hunos.map(t =\u003e `- [Hunos] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.yunqueLargas || []).map(t =\u003e `- [Yunque Larga] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.yunqueRapidas || []).map(t =\u003e `- [Yunque R√°pida] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.forjaTasks || []).map(t =\u003e `- [Roble] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.leones || []).map(t =\u003e `- [Leones] ID: \"${t.id}\" - \"${t.name}\" (Progreso: ${t.current}/${t.target})`).join('\\n')}\n${(data.sets || []).map(t =\u003e `- [Setas] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.trains || []).map(t =\u003e `- [Trenes] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.annualTrains || []).map(t =\u003e `- [Trenes Anuales] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.projects || []).map(t =\u003e `- [Nubes] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}","StartLine":1221,"TargetContent":"--- TAREAS DE HOY (Hunos, Yunque, Roble, Leones, Setas, Trenes, Trenes Anuales) ---\n${data.hunos.map(t =\u003e `- [Hunos] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.yunqueLargas || []).map(t =\u003e `- [Yunque Larga] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.yunqueRapidas || []).map(t =\u003e `- [Yunque R√°pida] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.forjaTasks || []).map(t =\u003e `- [Roble] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.leones || []).map(t =\u003e `- [Leones] ID: \"${t.id}\" - \"${t.name}\" (Progreso: ${t.current}/${t.target})`).join('\\n')}\n${(data.sets || []).map(t =\u003e `- [Setas] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.trains || []).map(t =\u003e `- [Trenes] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}\n${(data.annualTrains || []).map(t =\u003e `- [Trenes Anuales] ID: \"${t.id}\" - \"${t.text}\" (Completada: ${t.completed})`).join('\\n')}"},{"AllowMultiple":false,"EndLine":1422,"ReplacementContent":"          // Annual Trains (Anuales)\n          const atIndex = (updatedData.annualTrains || []).findIndex(t =\u003e t.id === id);\n          if (atIndex !== -1) {\n            const oldAT = (updatedData.annualTrains || [])[atIndex];\n            if (oldAT.completed !== completed) {\n              const updatedAT = [...(updatedData.annualTrains || [])];\n              updatedAT[atIndex] = { ...oldAT, completed };\n              updatedData.annualTrains = updatedAT;\n              successMsgs.push(`¬°Tren anual \"${oldAT.text}\" ${completed ? 'completada' : 'desmarcada'}!`);\n            }\n            return;\n          }\n\n          // Nubes (Proyectos)\n          const projIndex = (updatedData.projects || []).findIndex(t =\u003e t.id === id);\n          if (projIndex !== -1) {\n            const oldProj = (updatedData.projects || [])[projIndex];\n            if (oldProj.completed !== completed) {\n              const updatedProjects = [...(updatedData.projects || [])];\n              updatedProjects[projIndex] = { ...oldProj, completed };\n              updatedData.projects = updatedProjects;\n              successMsgs.push(`¬°Nube \"${oldProj.text}\" ${completed ? 'completada' : 'desmarcada'}!`);\n            }\n            return;\n          }\n        });\n      }","StartLine":1418,"TargetContent":"          // Annual Trains (Anuales)\n          const atIndex = (updatedData.annualTrains || []).findIndex(t =\u003e t.id === id);\n          if (atIndex !== -1) {\n            const oldAT = (updatedData.annualTrains || [])[atIndex];\n            if (oldAT.completed !== completed) {\n              const updatedAT = [...(updatedData.annualTrains || [])];\n              updatedAT[atIndex] = { ...oldAT, completed };\n              updatedData.annualTrains = updatedAT;\n              successMsgs.push(`¬°Tren anual \"${oldAT.text}\" ${completed ? 'completada' : 'desmarcada'}!`);\n            }\n            return;\n          }\n        });\n      }"},{"AllowMultiple":false,"EndLine":1580,"ReplacementContent":"  const handleProjectTextChange = (id: string, newText: string) =\u003e {\n    setData(prev =\u003e ({\n      ...prev,\n      projects: prev.projects.map(p =\u003e p.id === id ? { ...p, text: newText } : p)\n    }));\n  };\n\n  const handleProjectNotesChange = (id: string, newNotes: string) =\u003e {\n    setData(prev =\u003e ({\n      ...prev,\n      projects: prev.projects.map(p =\u003e p.id === id ? { ...p, notes: newNotes } : p)\n    }));\n  };\n\n  const initiateAddProject = () =\u003e { setIsAddingProject(true); setNewProjectText(''); };","StartLine":1573,"TargetContent":"  const handleProjectTextChange = (id: string, newText: string) =\u003e {\n    setData(prev =\u003e ({\n      ...prev,\n      projects: prev.projects.map(p =\u003e p.id === id ? { ...p, text: newText } : p)\n    }));\n  };\n\n  const initiateAddProject = () =\u003e { setIsAddingProject(true); setNewProjectText(''); };"},{"AllowMultiple":false,"EndLine":1736,"ReplacementContent":"  const isPriorityTaskCompleted = (taskId: string | null): boolean =\u003e {\n    if (!taskId || taskId === 'none') return false;\n    \n    const huno = data.hunos.find(t =\u003e t.id === taskId);\n    if (huno) return huno.completed;\n\n    const yl = (data.yunqueLargas || []).find(t =\u003e t.id === taskId);\n    if (yl) return yl.completed;\n\n    const yr = (data.yunqueRapidas || []).find(t =\u003e t.id === taskId);\n    if (yr) return yr.completed;\n\n    const ft = (data.forjaTasks || []).find(t =\u003e t.id === taskId);\n    if (ft) return ft.completed;\n\n    const lt = (data.leones || []).find(t =\u003e t.id === taskId);\n    if (lt) return lt.current \u003e= lt.target;\n\n    // For weekly tasks (Setas), link completion status to the corresponding daily Huno containing \"seta\"\n    if ((data.sets || []).some(t =\u003e t.id === taskId)) {\n      const setaHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('seta'));\n      return setaHuno ? setaHuno.completed : false;\n    }\n\n    // For monthly/annual tasks (Trenes), link completion status to the corresponding daily Huno containing \"tren\"\n    if ((data.trains || []).some(t =\u003e t.id === taskId) || (data.annualTrains || []).some(t =\u003e t.id === taskId)) {\n      const trenHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('tren'));\n      return trenHuno ? trenHuno.completed : false;\n    }\n\n    // For Nubes (proyectos), link completion status to the corresponding daily Huno containing \"nube\" or \"proyecto\"\n    if ((data.projects || []).some(t =\u003e t.id === taskId)) {\n      const nubeHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('nube') || h.text.toLowerCase().includes('proyecto'));\n      return nubeHuno ? nubeHuno.completed : false;\n    }\n\n    // For Leones (resources), link completion status to the corresponding daily Huno containing \"le√≥n\" or \"leon\" or \"leones\"\n    if ((data.leones || []).some(t =\u003e t.id === taskId)) {\n      const leonesHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('le√≥n') || h.text.toLowerCase().includes('leon') || h.text.toLowerCase().includes('leones'));\n      return leonesHuno ? leonesHuno.completed : false;\n    }\n\n    return false;\n  };\n\n  const getPriorityTaskText = (taskId: string | null): string =\u003e {\n    if (!taskId || taskId === 'none') return \"\";\n\n    const huno = data.hunos.find(t =\u003e t.id === taskId);\n    if (huno) return huno.text;\n\n    const yl = (data.yunqueLargas || []).find(t =\u003e t.id === taskId);\n    if (yl) return yl.text;\n\n    const yr = (data.yunqueRapidas || []).find(t =\u003e t.id === taskId);\n    if (yr) return yr.text;\n\n    const ft = (data.forjaTasks || []).find(t =\u003e t.id === taskId);\n    if (ft) return ft.text;\n\n    const lt = (data.leones || []).find(t =\u003e t.id === taskId);\n    if (lt) return lt.name;\n\n    const st = (data.sets || []).find(t =\u003e t.id === taskId);\n    if (st) return st.text;\n\n    const tr = (data.trains || []).find(t =\u003e t.id === taskId);\n    if (tr) return tr.text;\n\n    const atr = (data.annualTrains || []).find(t =\u003e t.id === taskId);\n    if (atr) return atr.text;\n\n    const projectTask = (data.projects || []).find(t =\u003e t.id === taskId);\n    if (projectTask) return projectTask.text;\n\n    return \"Tarea desconocida\";\n  };\n\n  const getPriorityTaskType = (taskId: string | null): string =\u003e {\n    if (!taskId || taskId === 'none') return \"\";\n\n    if (data.hunos.some(t =\u003e t.id === taskId)) return \"Hunos\";\n    if ((data.yunqueLargas || []).some(t =\u003e t.id === taskId)) return \"Yunque (Larga)\";\n    if ((data.yunqueRapidas || []).some(t =\u003e t.id === taskId)) return \"Yunque (R√°pida)\";\n    if ((data.forjaTasks || []).some(t =\u003e t.id === taskId)) return \"Roble\";\n    if ((data.leones || []).some(t =\u003e t.id === taskId)) return \"Leones\";\n    if ((data.sets || []).some(t =\u003e t.id === taskId)) return \"Setas (Semanales)\";\n    if ((data.trains || []).some(t =\u003e t.id === taskId)) return \"Trenes (Mensuales)\";\n    if ((data.annualTrains || []).some(t =\u003e t.id === taskId)) return \"Trenes Anuales\";\n    if ((data.projects || []).some(t =\u003e t.id === taskId)) return \"Nubes (Proyectos)\";\n\n    return \"Desconocido\";\n  };\n\n  const handlePriorityTaskToggle = (taskId: string | null) =\u003e {\n    if (!taskId || taskId === 'none') return;\n\n    const isCompleted = isPriorityTaskCompleted(taskId);\n\n    if (data.hunos.some(t =\u003e t.id === taskId)) {\n      const nextHunos = data.hunos.map(t =\u003e t.id === taskId ? { ...t, completed: !isCompleted } : t);\n      handleHunosUpdate(nextHunos);\n      return;\n    }\n\n    // For weekly tasks (Setas), toggle the daily Huno instead of the specific weekly task\n    if ((data.sets || []).some(t =\u003e t.id === taskId)) {\n      const setaHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('seta'));\n      if (setaHuno) {\n        const nextHunos = data.hunos.map(t =\u003e t.id === setaHuno.id ? { ...t, completed: !isCompleted } : t);\n        handleHunosUpdate(nextHunos);\n      }\n      return;\n    }\n\n    // For monthly/annual tasks (Trenes), toggle the daily Huno instead of the specific monthly/annual task\n    if ((data.trains || []).some(t =\u003e t.id === taskId) || (data.annualTrains || []).some(t =\u003e t.id === taskId)) {\n      const trenHuno = data.hunos.find(h =\u003e h.text.toLowerCase().includes('tren'));\n      if (trenHuno) {\n        const nextHunos = data.hunos.map(t =\u003e t.id === trenHuno.id ? { ...t, completed: !isCompleted } : t);\n        handleHunosUpdate(nextHuno